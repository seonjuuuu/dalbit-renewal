{
  "buildCommand": "vite build && node scripts/build-prerender.mjs",
  "outputDirectory": "dist/public",
  "headers": [
    {
      "source": "/rss.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=UTF-8" }
      ]
    },
    {
      "source": "/rss",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=UTF-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/rss", "destination": "/rss.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
